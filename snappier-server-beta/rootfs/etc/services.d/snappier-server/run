#!/usr/bin/with-contenv bashio

set -o pipefail

bashio::log.info "Starting Snappier Server v${SNAPPIER_SERVER_VERSION:-unknown}..."

# Get configuration from Home Assistant
export SNAPPIER_DOWNLOAD_SPEED_LIMIT=$(bashio::config 'download_speed_limit_mbs')
export SNAPPIER_RECORDINGS_FOLDER=$(bashio::config 'recordings_folder')
export SNAPPIER_MOVIES_FOLDER=$(bashio::config 'movies_folder')
export SNAPPIER_SERIES_FOLDER=$(bashio::config 'series_folder')
export SNAPPIER_PVR_FOLDER=$(bashio::config 'pvr_folder')
export SNAPPIER_ENABLE_REMUX=$(bashio::config 'enable_remux')
export SNAPPIER_USE_CURL=$(bashio::config 'use_curl_to_download')
export ENABLE_EPG=$(bashio::config 'enable_epg')
export EPG_URLS=$(bashio::config 'epg_urls' | jq -c '.')
export EPG_REFRESH_INTERVAL=$(bashio::config 'epg_refresh_interval')
_epg_folder=$(bashio::config 'epg_folder')
[ -n "${_epg_folder}" ] && export EPG_FOLDER="${_epg_folder}"

# Use fixed container ports - external mapping is handled by Home Assistant
export SNAPPIER_PORT=8000
export TZ=$(bashio::config 'timezone')
WEB_PROTOCOL="http"
export HOME="/share/snappier"

# Create necessary directories
mkdir -p "${SNAPPIER_RECORDINGS_FOLDER}" "${SNAPPIER_MOVIES_FOLDER}" "${SNAPPIER_SERIES_FOLDER}" "${SNAPPIER_PVR_FOLDER}"

bashio::log.info "Snappier Server configuration:"
bashio::log.info "  Port: ${SNAPPIER_PORT}"
bashio::log.info "  Recordings: ${SNAPPIER_RECORDINGS_FOLDER}"
bashio::log.info "  Movies: ${SNAPPIER_MOVIES_FOLDER}"
bashio::log.info "  Series: ${SNAPPIER_SERIES_FOLDER}"
bashio::log.info "  PVR: ${SNAPPIER_PVR_FOLDER}"
bashio::log.info "  EPG enabled: ${ENABLE_EPG}"
bashio::log.info "  EPG refresh interval: ${EPG_REFRESH_INTERVAL}h"

# Prepare working directory and SSL cert path used by Snappier auto HTTPS mode.
mkdir -p /root/SnappierServer && cd /root/SnappierServer
mkdir -p Recordings Movies TVSeries PVR

SSL_CERT=$(bashio::config 'ssl_cert')
SSL_KEY=$(bashio::config 'ssl_key')

if [ -n "${SSL_CERT}" ] && [ -n "${SSL_KEY}" ] && [ -f "${SSL_CERT}" ] && [ -f "${SSL_KEY}" ]; then
    mkdir -p ./certs
    cp -f "${SSL_CERT}" ./certs/fullchain.pem
    cp -f "${SSL_KEY}" ./certs/privkey.pem
    chmod 600 ./certs/fullchain.pem ./certs/privkey.pem
    WEB_PROTOCOL="https"
    bashio::log.info "SSL certificates detected. HTTPS mode will be enabled automatically."
else
    bashio::log.info "No SSL certificate paths configured or files not found. Running in HTTP mode."
fi

# Check if snappier-server binary exists
if [ ! -f "/usr/local/bin/snappier-server" ]; then
    bashio::log.error "Snappier Server binary not found at /usr/local/bin/snappier-server"
    exit 1
fi

# Debug: Check binary information
bashio::log.info "Binary information:"
ls -la /usr/local/bin/snappier-server
file /usr/local/bin/snappier-server

# Make sure the binary is executable
chmod +x /usr/local/bin/snappier-server

# Test if the binary can be executed
if ! /usr/local/bin/snappier-server --help >/dev/null 2>&1; then
    bashio::log.error "Binary cannot be executed. This might be due to:"
    bashio::log.error "1. Missing dynamic libraries (try: ldd /usr/local/bin/snappier-server)"
    bashio::log.error "2. Wrong architecture or libc version"
    bashio::log.error "3. Binary corruption"
    
    # Try to get more information
    ldd /usr/local/bin/snappier-server 2>&1 || bashio::log.warning "ldd failed - static binary or missing libraries"
    
    bashio::log.error "Falling back to placeholder mode..."
    while true; do
        bashio::log.info "Snappier Server is running in placeholder mode (binary not executable)"
        bashio::log.info "Web interface would be available at: ${WEB_PROTOCOL}://[HOST]:${SNAPPIER_PORT}"
        sleep 300
    done
fi

# Start Snappier Server
bashio::log.info "Starting Snappier Server binary with environment configuration..."

# Set up environment variables that Snappier Server expects
export PORT="${SNAPPIER_PORT}"
export ENABLE_REMUX="${SNAPPIER_ENABLE_REMUX}"
export USE_CURL_TO_DOWNLOAD="${SNAPPIER_USE_CURL}"
export RECORDINGS_FOLDER="${SNAPPIER_RECORDINGS_FOLDER}"
export MOVIES_FOLDER="${SNAPPIER_MOVIES_FOLDER}"
export SERIES_FOLDER="${SNAPPIER_SERIES_FOLDER}"
export PVR_FOLDER="${SNAPPIER_PVR_FOLDER}"
export DOWNLOAD_SPEED_LIMIT_MBS="${SNAPPIER_DOWNLOAD_SPEED_LIMIT}"
export ENABLE_EPG="${ENABLE_EPG}"
export EPG_URLS="${EPG_URLS}"
export EPG_REFRESH_INTERVAL="${EPG_REFRESH_INTERVAL}"

bashio::log.info "Environment variables set for Snappier Server:"
bashio::log.info "  PORT=${PORT}"
bashio::log.info "  PROTOCOL=${WEB_PROTOCOL}"
bashio::log.info "  RECORDINGS_FOLDER=${RECORDINGS_FOLDER}"
bashio::log.info "  Working directory: $(pwd)"

persist_api_token_option() {
    local token="$1"
    local current_token

    current_token="$(bashio::config 'api_token')"
    if [ "${token}" = "${current_token}" ]; then
        return 0
    fi

    local payload
    payload="$(jq -n \
        --argjson use_curl_to_download "$(bashio::config 'use_curl_to_download')" \
        --argjson download_speed_limit_mbs "$(bashio::config 'download_speed_limit_mbs')" \
        --argjson enable_remux "$(bashio::config 'enable_remux')" \
        --argjson enable_epg "$(bashio::config 'enable_epg')" \
        --argjson epg_urls "$(bashio::config 'epg_urls' | jq -c '.')" \
        --argjson epg_refresh_interval "$(bashio::config 'epg_refresh_interval')" \
        --arg recordings_folder "$(bashio::config 'recordings_folder')" \
        --arg movies_folder "$(bashio::config 'movies_folder')" \
        --arg series_folder "$(bashio::config 'series_folder')" \
        --arg pvr_folder "$(bashio::config 'pvr_folder')" \
        --arg api_token "${token}" \
        --arg timezone "$(bashio::config 'timezone')" \
        '{
            options: {
                use_curl_to_download: $use_curl_to_download,
                download_speed_limit_mbs: $download_speed_limit_mbs,
                enable_remux: $enable_remux,
                enable_epg: $enable_epg,
                epg_urls: $epg_urls,
                epg_refresh_interval: $epg_refresh_interval,
                recordings_folder: $recordings_folder,
                movies_folder: $movies_folder,
                series_folder: $series_folder,
                pvr_folder: $pvr_folder,
                api_token: $api_token,
                timezone: $timezone
            }
        }')"

    if curl -sS \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "${payload}" \
        "http://supervisor/addons/self/options" >/dev/null; then
        bashio::log.info "Stored API token in add-on settings (api_token)."
    else
        bashio::log.warning "Could not persist API token to add-on settings."
    fi
}

# Start Snappier Server and redact sensitive token output from logs.
mkdir -p /share/snappier
/usr/local/bin/snappier-server -config /share/snappier/config.json 2>&1 | while IFS= read -r line; do
    if [[ "${line}" =~ \.Auth\..*[Tt]oken.*:[[:space:]]*([A-Za-z0-9_\-\.]{8,}) ]] || \
       [[ "${line}" =~ [Aa][Pp][Ii][[:space:]][Tt]oken.*:[[:space:]]*([A-Za-z0-9_\-\.]{8,}) ]] || \
       [[ "${line}" =~ \[Auth\].*[Tt]oken.*:[[:space:]]*([A-Za-z0-9_\-\.]{8,}) ]]; then
        token="${BASH_REMATCH[1]}"
        echo "${line//${token}/[REDACTED]}"
        persist_api_token_option "${token}"
    else
        echo "${line}"
    fi
done

exit ${PIPESTATUS[0]}